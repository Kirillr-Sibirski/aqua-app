# Copy to .env (git-ignored). Every variable is optional; the defaults below are what the scripts use anyway.

# ---- local Base fork (scripts/fork/start.sh) ----
# Upstream archive RPC for Base; falls back to https://mainnet.base.org and https://base.drpc.org automatically.
ANVIL_FORK_URL=https://gateway.tenderly.co/public/base
# Pinned fork block (2026-09-05, Base). Change only together with the whale/oracle notes in scripts/fork/start.sh.
ANVIL_FORK_BLOCK=50946000
ANVIL_CHAIN_ID=31337
ANVIL_HOST=127.0.0.1
ANVIL_PORT=8545
# Seconds per block; leave empty for automine (one block per tx — best for demos)
ANVIL_BLOCK_TIME=
# Where the TS scripts connect
ANVIL_RPC_URL=http://127.0.0.1:8545

# ---- bootstrap (scripts/fork/bootstrap.ts) ----
# Your MetaMask/Rabby EOA — gets ETH/WETH/USDC/cbBTC on the fork in addition to anvil accounts #0-#3
DEMO_ADDRESS=
# Foundry artifact of the router to deploy against the official Aqua. ProbeRouter is the bare
# SwapVM+AquaOpcodes probe and has neither custom instruction; the app needs StrikelineRouter.
ROUTER_ARTIFACT=contracts/out/StrikelineRouter.sol/StrikelineRouter.json
# Only used when the artifact's constructor takes (aqua, weth, owner, name, version)
ROUTER_NAME=Strikeline
ROUTER_VERSION=1
# Funding targets per wallet (human units). Irregular on purpose: round demo numbers read as fake
# even when they are real. ETH is above anvil's own 10,000 default so the top-up actually applies.
FUND_ETH=12450.75
FUND_WETH=146.83
FUND_USDC=418655
FUND_CBBTC=1.4472
# FORCE_REDEPLOY=1     ignore an existing deployments manifest and deploy a fresh router
# FUND_VIA_STORAGE=1   skip whale impersonation, write balances with anvil_setStorageAt

# ---- contracts fork tests (make test-fork; Ethereum mainnet addresses) ----
FORK_RPC_URL=https://ethereum-rpc.publicnode.com

# ---- web (web/.env.local; every key is optional — the app reads web/public/deployments/local.json) ----
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_ID=31337
# Real Base RPC for the second configured chain
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
# "Demo mode" burner connector key (default: anvil account #1). Local fork only — never a real key.
NEXT_PUBLIC_DEMO_PRIVATE_KEY=
# Override where the manifest is fetched from (default /deployments/local.json)
NEXT_PUBLIC_DEPLOYMENTS_URL=
# Fallback used only when the manifest cannot be fetched; NEXT_PUBLIC_ROUTER is what turns it on.
NEXT_PUBLIC_ROUTER=
NEXT_PUBLIC_AQUA=0x1111113CCf1426A8E30e2bfF5E005d929bF6a90a
NEXT_PUBLIC_OFFICIAL_ROUTER=0x111111338c5091E8440b67B168bAe16a668AC0De
NEXT_PUBLIC_WETH=0x4200000000000000000000000000000000000006
NEXT_PUBLIC_USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
NEXT_PUBLIC_CBBTC=0xcbB7C0000aB88B473b1f5aFd9ef808440eed33Bf
NEXT_PUBLIC_CHAINLINK_ETH_USD=0x71041dddad3595F9CEd3DcCFBe3D1F4b0a16Bb70
NEXT_PUBLIC_CHAINLINK_BTC_USD=0x64c911996D3c6aC71f9b455B1E8E7266BcbD848F
NEXT_PUBLIC_CHAINLINK_CBBTC_USD=0x07DA0E54543a844a80ABE69c8A12F22B3aA59f9D
NEXT_PUBLIC_CHAINLINK_USDC_USD=0x7e860098F58bBFC8648a4311b374B1D669a2bc6B
# Block the Shipped-log scan starts from (default: the manifest's fork block)
NEXT_PUBLIC_DEPLOY_BLOCK=50946000

# ---- hosted demo (Vercel) ----
# Server-side only: the plain-HTTP anvil the /api/rpc relay forwards to. Unset, the relay answers 404.
RPC_UPSTREAM=
# On the hosted site, point the browser at the relay, e.g. https://<your-site>/api/rpc
# NEXT_PUBLIC_RPC_URL=https://strikeline-mu.vercel.app/api/rpc

# ---- scripts against a remote chain (optional) ----
# RPC_URL=http://<host>:8545          run make story-* against another anvil instead of 127.0.0.1
# CHAIN_BACKEND=tenderly              translate anvil cheatcodes for a Tenderly Virtual TestNet (unused by the live demo)
# MANIFEST_RPC_URL=                   public RPC written into the manifest instead of the admin one
# DEPLOYMENTS=                        scripts' manifest path override
# WEB_DEPLOYMENTS=                    web manifest path override
