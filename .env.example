# Copy to .env (git-ignored). Every variable is optional; the defaults below are what the scripts use anyway.

# ---- local Base fork (scripts/fork/start.sh) ----
# Upstream archive RPC for Base; falls back to https://mainnet.base.org and https://base.drpc.org automatically.
ANVIL_FORK_URL=https://gateway.tenderly.co/public/base
# Pinned fork block (2026-09-05, Base). Change only together with the whale/oracle notes in scripts/fork/start.sh.
ANVIL_FORK_BLOCK=50946000
ANVIL_CHAIN_ID=31337
ANVIL_HOST=127.0.0.1
ANVIL_PORT=8545
# Seconds per block; leave empty for automine (one block per tx — best for demos)
ANVIL_BLOCK_TIME=
# Where the TS scripts connect
ANVIL_RPC_URL=http://127.0.0.1:8545

# ---- bootstrap (scripts/fork/bootstrap.ts) ----
# Your MetaMask/Rabby EOA — gets ETH/WETH/USDC/cbBTC on the fork in addition to anvil accounts #0-#3
DEMO_ADDRESS=
# Foundry artifact of the router to deploy against the official Aqua (swap in the real router here later)
ROUTER_ARTIFACT=contracts/out/ProbeRouter.sol/ProbeRouter.json
# Only used when the artifact's constructor takes (aqua, weth, owner, name, version)
ROUTER_NAME=Aqua App SwapVM
ROUTER_VERSION=1
# Funding targets per wallet (human units)
FUND_ETH=1000
FUND_WETH=100
FUND_USDC=500000
FUND_CBBTC=5
# FORCE_REDEPLOY=1     ignore an existing deployments manifest and deploy a fresh router
# FUND_VIA_STORAGE=1   skip whale impersonation, write balances with anvil_setStorageAt

# ---- contracts fork tests (make test-fork; Ethereum mainnet addresses) ----
FORK_RPC_URL=https://ethereum-rpc.publicnode.com

# ---- web ----
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_ID=31337
